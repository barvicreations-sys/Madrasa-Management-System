{
  "entities": {
    "User": {
      "title": "User",
      "description": "System user with role-based access",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "teacher", "accountant"] },
        "name": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "Student": {
      "title": "Student",
      "description": "Madrasa student profile",
      "type": "object",
      "properties": {
        "regNo": { "type": "string" },
        "name": { "type": "string" },
        "nameUrdu": { "type": "string" },
        "fatherName": { "type": "string" },
        "dob": { "type": "string", "format": "date" },
        "address": { "type": "string" },
        "phone": { "type": "string" },
        "classId": { "type": "string" },
        "photoUrl": { "type": "string" },
        "admissionDate": { "type": "string", "format": "date" },
        "status": { "type": "string", "enum": ["active", "graduated", "dropped"] }
      },
      "required": ["regNo", "name", "classId"]
    },
    "Teacher": {
      "title": "Teacher",
      "description": "Madrasa teacher profile",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "nameUrdu": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "qualification": { "type": "string" },
        "joinDate": { "type": "string", "format": "date" },
        "salary": { "type": "number" }
      },
      "required": ["name", "email"]
    },
    "Class": {
      "title": "Class",
      "description": "Madrasa class or section",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "nameUrdu": { "type": "string" },
        "section": { "type": "string" },
        "teacherId": { "type": "string" }
      },
      "required": ["name"]
    },
    "Attendance": {
      "title": "Attendance",
      "description": "Student daily attendance",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "status": { "type": "string", "enum": ["present", "absent", "leave"] },
        "remarks": { "type": "string" }
      },
      "required": ["studentId", "date", "status"]
    },
    "Fee": {
      "title": "Fee",
      "description": "Student fee records",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string", "enum": ["admission", "monthly", "exam", "other"] },
        "month": { "type": "string" },
        "year": { "type": "number" },
        "date": { "type": "string", "format": "date" },
        "receiptNo": { "type": "string" },
        "status": { "type": "string", "enum": ["paid", "unpaid"] }
      },
      "required": ["studentId", "amount", "type", "date"]
    },
    "Exam": {
      "title": "Exam",
      "description": "Madrasa exams",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "nameUrdu": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "classId": { "type": "string" }
      },
      "required": ["name", "classId"]
    },
    "Result": {
      "title": "Result",
      "description": "Student exam results",
      "type": "object",
      "properties": {
        "examId": { "type": "string" },
        "studentId": { "type": "string" },
        "marksObtained": { "type": "number" },
        "totalMarks": { "type": "number" },
        "grade": { "type": "string" },
        "remarks": { "type": "string" }
      },
      "required": ["examId", "studentId", "marksObtained", "totalMarks"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "User",
      "description": "User profiles and roles"
    },
    "/students/{studentId}": {
      "schema": "Student",
      "description": "Student records"
    },
    "/teachers/{teacherId}": {
      "schema": "Teacher",
      "description": "Teacher records"
    },
    "/classes/{classId}": {
      "schema": "Class",
      "description": "Class definitions"
    },
    "/attendance/{attendanceId}": {
      "schema": "Attendance",
      "description": "Attendance history"
    },
    "/fees/{feeId}": {
      "schema": "Fee",
      "description": "Fee transaction history"
    },
    "/exams/{examId}": {
      "schema": "Exam",
      "description": "Exam schedules"
    },
    "/results/{resultId}": {
      "schema": "Result",
      "description": "Exam performance data"
    }
  }
}
